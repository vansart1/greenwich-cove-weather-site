// Cloudflare Workers Builds config.
// A small Worker script (src/worker.js) handles the /refresh endpoint and falls
// through to static assets for everything else.
{
  "name": "greenwich-cove-weather-site",
  "compatibility_date": "2025-01-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // /refresh is a public, unauthenticated button that pushes to Victor's phone,
  // so it gets two limits per visitor: a burst limit and a daily cap.
  // The native binding only supports a 10s or 60s window, hence KV for the day.
  "ratelimits": [
    {
      "name": "REFRESH_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 1, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "REFRESH_COUNTS",
      "id": "18c8fff2986d4d1192c7ce9b7ba3324e"
    }
  ]
}
